POSTGRES_PASSWORD=delo-local-demo
SECRET_KEY=local-demo-change-before-publishing
CORS_ORIGINS=http://localhost:5173,http://localhost
BUREAU_AVAILABLE=true
DEMO_TOOLS_ENABLED=false
WEB_PORT=80

# Qwen inference is a separate GPU service. Never point this at a public unauthenticated endpoint.
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=Qwen/Qwen3.8-27B
ASSISTANT_BASE_URL=http://host.docker.internal:8001/v1
ASSISTANT_API_KEY=
